(package (name prbnmcn-mcts)
  (synopsis "Monte-Carlo tree search based on UCB1 bandits")
  (description "This library provides a monadic API to describe lazily evaluated, finitely branching trees. It allows to use Monte-Carlo tree search to perform reward-guided exploration of these trees.")
